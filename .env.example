# Raw MySQL connection (used by config/db.js via mysql2/promise pool)
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_USER="root"
DB_PASS=""
DB_NAME="azuremed_hub"

# NextAuth
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Google AI (Vertex AI / AutoML Vision) prediction endpoint for the image
# detection proxy route (app/api/ai/detect/route.ts). Never exposed to the
# client — only read server-side.
GOOGLE_AI_ENDPOINT="https://us-central1-aiplatform.googleapis.com/v1/projects/PROJECT_ID/locations/us-central1/endpoints/ENDPOINT_ID:predict"
GOOGLE_AI_API_KEY="replace-with-service-account-bearer-token"

# reCAPTCHA v3 on login + register (lib/recaptcha.ts, lib/recaptchaClient.ts).
# Both must be set together — register a v3 site at
# https://www.google.com/recaptcha/admin. Left unset, this feature is fully
# inert (no CAPTCHA shown, nothing blocked) so it's safe to leave blank in
# dev. NEXT_PUBLIC_RECAPTCHA_SITE_KEY is exposed to the browser by design
# (that's how reCAPTCHA works); RECAPTCHA_SECRET_KEY must never be.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""

# SMTP — used by lib/mailer.ts to send the "Forgot Password" reset email.
# Works with any SMTP provider (Gmail with an app password, Resend,
# SendGrid, Mailgun, etc). Left unset, the app doesn't fail — it logs the
# real reset link to the server console instead of emailing it, so the flow
# still works end-to-end in local dev without real credentials.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="AzureMed Hub <no-reply@azuremedhub.com>"

# Shared secret for app/api/support/telegram/route.ts and .../answer/ — the
# medicalbot Telegram bot (../Telegram-bot/medicalbot) sends this as the
# x-bot-secret header to submit/check/answer support tickets without a
# website login session. Generate with: openssl rand -hex 32
# Put the SAME value in the bot's own .env as BOT_API_SECRET. Left unset,
# these routes return 503 and the bot's support features fail gracefully.
BOT_API_SECRET=""

# Same Telegram bot token as the bot's own .env BOT_TOKEN — lets
# lib/telegramNotify.ts push messages (new-question alerts to linked staff,
# answers back to customers) directly via the Telegram Bot API, independent
# of whether the bot process itself is running. Get it from @BotFather.
# For local dev, use a SEPARATE bot from production (see bot/README.md) —
# a chat_id is only valid for the specific bot the customer messaged, so
# this must match whichever bot's token bot/.env is using locally, not
# production's.
BOT_TOKEN=""

# Telegram username of the /medicalbot bot (no leading @), used by the
# floating "Need Help?" button (components/NeedHelpButton.tsx) to deep-link
# into t.me/<username>. Left unset, the button renders but does nothing on
# click.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=""

# Optional — locks down app/api/cron/release-expired-reservations. Vercel
# auto-attaches this as a Bearer token to requests it fires from vercel.json's
# `crons` entry once this is set as a project env var. Left unset, that route
# stays open (fine — it's a best-effort tidiness sweep, not required for cart
# reservation correctness, and there's nothing sensitive it returns).
# Generate with: openssl rand -hex 32
CRON_SECRET=""

