# medicalbot — Telegram bot for azuremed-hub. Copy to .env for local dev;
# on Railway these are set as service Variables instead, not a real file.

# From @BotFather. Rotate via /revoke + /token there if it's ever leaked
# (e.g. hardcoded in source, committed to git, pasted somewhere public).
BOT_TOKEN=

# Base URL of the azuremed-hub deployment this bot talks to (no trailing
# slash). Local dev: http://localhost:3000. Production: your real
# https://... domain — required for the "Visit website"/"View on website"
# buttons to render at all (Telegram rejects non-https URL buttons).
API_BASE_URL=http://localhost:3000

# Only needed if the public site is on a different host than API_BASE_URL.
# Defaults to API_BASE_URL.
# SITE_URL=https://azuremedhub.com

# Must match BOT_API_SECRET in azuremed-hub's own environment exactly.
# Generate with: openssl rand -hex 32
BOT_API_SECRET=
